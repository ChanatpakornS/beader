{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Machine-readable module map and dependency rules for the Beader repository. AI coding agents should validate proposed build.gradle.kts changes against this file before writing them.",
  "rootPackage": "com.beader",
  "moduleTypes": {
    "app": {
      "description": "Application entry point. Owns Application/Activity, top-level NavHost, and the root Hilt @HiltAndroidApp.",
      "androidLibrary": false,
      "isApplication": true,
      "mayDependOn": ["feature", "core-ui", "core-infrastructure", "core-domain"]
    },
    "feature": {
      "description": "One user-facing feature: ViewModel, UiState, Composable screens, its own NavGraphBuilder extension.",
      "androidLibrary": true,
      "isApplication": false,
      "mayDependOn": ["core-domain", "core-ui"],
      "mustNotDependOn": ["feature", "app", "core-infrastructure"]
    },
    "core-domain": {
      "description": "Pure Kotlin/JVM. Domain models, repository interfaces, use cases. No Android SDK dependency permitted.",
      "androidLibrary": false,
      "isApplication": false,
      "mayDependOn": ["core-common"],
      "mustNotDependOn": ["feature", "app", "core-infrastructure", "core-ui"],
      "forbiddenImportPrefixes": ["android.", "androidx."]
    },
    "core-data": {
      "description": "Implements core-domain repository interfaces. Maps DTOs/entities to domain models. Bound via Hilt @Binds.",
      "androidLibrary": true,
      "isApplication": false,
      "mayDependOn": ["core-domain", "core-common", "core-infrastructure"],
      "mustNotDependOn": ["feature", "app", "core-ui"]
    },
    "core-infrastructure": {
      "description": "Implementation-detail modules: core:network, core:database, core:datastore. Never referenced by feature modules directly.",
      "androidLibrary": true,
      "isApplication": false,
      "mayDependOn": ["core-common"],
      "mustNotDependOn": ["feature", "app", "core-domain", "core-data", "core-ui"]
    },
    "core-ui": {
      "description": "core:designsystem (theme, tokens, primitive components) and core:ui (composite reusable composables). No domain model imports.",
      "androidLibrary": true,
      "isApplication": false,
      "mayDependOn": [],
      "mustNotDependOn": ["feature", "app", "core-domain", "core-data", "core-infrastructure"],
      "forbiddenImportPatterns": ["com.beader.core.domain.model.*", "com.beader.core.network.model.*", "com.beader.core.database.entity.*"]
    },
    "core-common": {
      "description": "Pure Kotlin/JVM. Smallest, most-depended-on module: DataResult, dispatcher qualifiers, generic utilities only.",
      "androidLibrary": false,
      "isApplication": false,
      "mayDependOn": [],
      "mustNotDependOn": ["*"],
      "forbiddenImportPrefixes": ["android.", "androidx."]
    },
    "core-testing": {
      "description": "Test-only fakes and JUnit/Hilt test infrastructure. Only ever a testImplementation/androidTestImplementation dependency, never main implementation.",
      "androidLibrary": true,
      "isApplication": false,
      "mayDependOn": ["core-domain", "core-common"],
      "mustNotDependOn": ["feature", "app", "core-data", "core-infrastructure", "core-ui"],
      "onlyValidAs": ["testImplementation", "androidTestImplementation"]
    }
  },
  "modules": {
    ":app": { "type": "app" },
    ":feature:sample": { "type": "feature" },
    ":core:domain": { "type": "core-domain" },
    ":core:data": { "type": "core-data" },
    ":core:network": { "type": "core-infrastructure" },
    ":core:database": { "type": "core-infrastructure" },
    ":core:datastore": { "type": "core-infrastructure" },
    ":core:designsystem": { "type": "core-ui" },
    ":core:ui": { "type": "core-ui" },
    ":core:common": { "type": "core-common" },
    ":core:testing": { "type": "core-testing" }
  },
  "namingConventions": {
    "useCase": { "suffix": "UseCase", "module": ":core:domain", "package": "com.beader.core.domain.usecase" },
    "domainModel": { "module": ":core:domain", "package": "com.beader.core.domain.model" },
    "repositoryInterface": { "suffix": "Repository", "module": ":core:domain", "package": "com.beader.core.domain.repository" },
    "repositoryImpl": { "suffix": "RepositoryImpl", "module": ":core:data", "package": "com.beader.core.data.repository" },
    "networkDto": { "suffix": "Dto", "module": ":core:network", "package": "com.beader.core.network.model" },
    "databaseEntity": { "suffix": "Entity", "module": ":core:database", "package": "com.beader.core.database.entity" },
    "uiState": { "suffix": "UiState", "module": ":feature:*", "annotateWith": ["Immutable"] },
    "viewModel": { "suffix": "ViewModel", "module": ":feature:*", "annotateWith": ["HiltViewModel"] },
    "routeComposable": { "suffix": "Route", "description": "Only composable in a feature allowed to call hiltViewModel()." },
    "screenComposable": { "suffix": "Screen", "description": "Stateless, takes UiState + lambdas as parameters. Preferred target for UI tests." }
  },
  "stateManagement": {
    "required": "StateFlow",
    "forbidden": ["LiveData"],
    "exposurePattern": "private val _state: MutableStateFlow<T>; val state: StateFlow<T> = _state.asStateFlow()"
  },
  "diFramework": "Hilt",
  "diRules": {
    "injectionStyle": "constructor",
    "bindPattern": "@Binds abstract fun bind<Interface>(impl: <Impl>): <Interface>",
    "forbidden": ["field injection", "service locator", "manual Provides for constructor-injectable types"]
  }
}
