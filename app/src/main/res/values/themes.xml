<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — Compose owns all UI, this exists only to
         satisfy the manifest and to drive the launch splash screen. -->
    <style name="Theme.Beader" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Beader.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Beader</item>
    </style>
</resources>
